# Optional restricted browser key: Maps JavaScript API only. Visible by design.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_DEMO_MODE=true
VITE_GOOGLE_MAP_ID=
# SAM ApiBaseUrl output; no trailing slash. Leave blank for explicit demo mode.
VITE_API_BASE_URL=
# Minimum 60000 ms. Active/visible pages only; controls paid route refresh rate.
VITE_ROUTE_REFRESH_MS=300000
# Use /venomlink/ for GitHub project Pages, / for Amplify root hosting.
VITE_BASE_PATH=/
# Backend configuration uses IAM and Secrets Manager. Never place AWS access
# secrets or a server Google Routes key in VITE_ variables or Git.
